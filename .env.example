### Copy to .env and fill with your API keys and endpoints ###

# RapidAPI (crime provider)
RAPIDAPI_KEY=
RAPIDAPI_HOST=
# Example: https://api.provider.com/crime/{zip} -> supports {zip} placeholder
RAPIDAPI_CRIME_URL=

# Finnhub (news sentiment)
FINNHUB_KEY=
FINNHUB_SYMBOL=

# Optional overrides
OVERPASS_API_URL=
GDELT_API_URL=
# API Configuration Template
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to Git

# Overpass API (free, no key needed)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# GDELT API (free, no key needed)
GDELT_API_URL=https://api.gdeltproject.org/api/v2/search/tv

# Google Maps API (optional, if you want to add it later)
# GOOGLE_MAPS_API_KEY=your_api_key_here

# FRED Economic Data (free, no key needed for pandas_datareader)
# FRED_API_KEY=your_key_here (optional)

# Feature mode: 'live' for real APIs, 'simulated' for fallback
EXTERNAL_FEATURE_MODE=live
